# =====================================================
# Mank TV · 生产环境变量示例 (.env.production.example)
#
# ⚠️ 真相来源：本文件是生产环境变量的唯一示例模板
#
# 使用方法：
#   cp .env.production.example .env
#   然后根据实际情况修改所有值
#
# ⚠️ 警告：
#   - 严禁将 .env 文件提交到 Git 仓库
#   - 所有密钥必须使用随机字符串，不得使用示例默认值
#   - 数据库密码、JWT 密钥等请妥善保管
#   - 生产环境部署前必须轮换所有默认密钥
#
# 最后更新: 2026-09-07
# 维护者: 运维负责人
# =====================================================

# ============== 域名配置 ==============
# 前端访问地址（用于 CORS 白名单，多个域名用逗号分隔）
FRONTEND_URL=https://gaike.xyz,https://www.gaike.xyz

# ============== 安全密钥 ==============
# JWT 密钥（至少 32 字符随机字符串）
# 生成命令：openssl rand -hex 32
JWT_SECRET=replace-with-32-char-random-string-at-least
JWT_EXPIRES_IN=7d

# 图片签名密钥（防止前端绕过审核）
# 生成命令：openssl rand -hex 16
IMAGE_SIGNING_SECRET=replace-with-random-signing-key

# ============== 数据库 ==============
# PostgreSQL 生产推荐
DATABASE_URL=postgresql://manktv:change-me-in-production@postgres:5432/manktv?schema=public

# PostgreSQL 容器配置（与上面对应）
POSTGRES_DB=manktv
POSTGRES_USER=manktv
POSTGRES_PASSWORD=change-me-in-production

# ============== Redis（生产推荐） ==============
# 取消注释启用 Redis（限流 + 任务队列）
# REDIS_URL=redis://redis:6379/0

# ============== AI 供应商 · Pollinations ==============
# 申请 Key：https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=sk-your-pollinations-key-here
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_LLM_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux

# ============== LLM 文本模型 ==============
# zhipu = 智谱 GLM-4-Flash（免费，中文好）| pollinations = Pollinations
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_LLM_MODEL=glm-4-flash

# ============== 内容安全审核 ==============
MODERATION_ENABLED=true
MODERATION_LEVEL=standard
# 审核服务商：aliyun（阿里云）| zhipu（智谱）
MODERATION_PROVIDER=aliyun
MODERATION_API_KEY=your-moderation-api-key
MODERATION_API_SECRET=your-moderation-api-secret
MODERATION_REGION=cn-shanghai

# ============== 文件上传 ==============
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ============== 邮箱 SMTP（可选） ==============
# SMTP_USER=your_email@163.com
# SMTP_PASS=your_smtp_auth_code

# ============== 支付（可选） ==============
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# WECHAT_MCH_ID=
# WECHAT_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
