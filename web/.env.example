# =====================================================
# Man TV · 前端 Vite 环境变量模板 (.env.example)
# =====================================================
# 🔒 使用方法：复制本文件为 .env.development 或 .env.production
#    cp .env.example .env.development
# ⚠️ 警告：.env* 文件（除 .env.example）已被 .gitignore 排除
# =====================================================
# 📌 Vite 环境变量必须以 VITE_ 开头才会暴露给前端代码
# =====================================================

# ---------- 后端 API 基础地址 ----------
VITE_API_BASE_URL=http://localhost:3000

# ---------- 开发服务器端口（Vite 默认 5173） ----------
# 注意：VITE_PORT 不会自动应用到 Vite dev server，需在 vite.config.ts 中读取
# 本项目使用 Vite 默认 5173，与后端 CORS 默认值一致
VITE_PORT=5173

# ---------- 应用标题 ----------
VITE_APP_TITLE=AI漫剧圈 · Man TV

# ---------- 站点公开 URL（用于 meta / og:image） ----------
VITE_PUBLIC_SITE_URL=http://localhost:5176

# ---------- 图像供应商代理（可选，如需自定义域名） ----------
# VITE_IMAGE_PROXY_URL=http://localhost:3000/api/image/proxy

# ---------- Sentry / 监控（可选） ----------
# VITE_SENTRY_DSN=

# ---------- 功能开关 ----------
# 是否展示 Demo 角标（true=显示占位提示；生产可切为 false）
VITE_SHOW_DEMO_BADGE=true