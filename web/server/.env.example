# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除

# Pollinations API Key（必填，否则 LLM 调用会失败并自动降级到模板生成）
# 申请：https://enter.pollinations.ai/keys
# 类型：sk_ 服务端 secret key（推荐）；pk_ 前端 publishable key 有限流
POLLINATIONS_API_KEY=

# 文本模型（可选，默认 openai）
# 可选值参考 https://gen.pollinations.ai/v1/models：
#   openai / openai-fast / openai-large / gpt-5.4-mini
#   glm / glm-5.3                       ← 智谱（适合国内合规）
#   qwen / qwen-large / qwen3.7-max     ← 通义
#   deepseek / deepseek-pro
#   gemini-fast / gemini-3-flash
#   claude-fast / claude
POLLINATIONS_MODEL=glm

# 服务端口（可选，默认 8787）
PORT=8787
