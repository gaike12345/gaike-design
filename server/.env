# 服务端口
PORT=3000

# JWT 密钥（生产环境请更换为随机长字符串）
JWT_SECRET=mank-tv-jwt-secret-change-in-production-2026
JWT_EXPIRES_IN=7d

# 数据库（开发期 SQLite，生产切换 PostgreSQL）
DATABASE_URL="file:./dev.db"

# 前端地址（CORS 白名单）
FRONTEND_URL=http://localhost:5176

# LLM 供应商（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 图像供应商（Pollinations 免费版，无需 Key）
IMAGE_PROVIDER_URL=https://image.pollinations.ai/prompt

# 文件上传目录
UPLOAD_DIR=./uploads
