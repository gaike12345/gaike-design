// Prisma Schema — Man TV 后端数据模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 迁移说明：
//   - SQLite 时代使用 cuid() 作为主键，PostgreSQL 完全兼容
//   - 所有索引、外键、级联删除均通过 Prisma 抽象层定义，无 SQLite 特有语法
//   - 迁移工具：prisma migrate dev --name init（PostgreSQL 首次初始化）
//   - 数据迁移脚本：prisma/migrate-sqlite-to-pg.ts（从 SQLite dev.db 导入数据）

// ==================== 用户 ====================
model User {
  id        String   @id @default(cuid())
  uid       Int      @unique
  email     String   @unique
  password  String
  nickname  String
  avatar    String?
    banner    String?
    bio       String?
  role        String   @default("user")    // user | admin | superadmin
  enabled     Boolean  @default(true)      // false = 账号被关闭，禁止登录
  // 内容安全风险等级：0 正常 | 1 警告 | 2 限制（AI生成需人工复核）| 3 封禁AI生成
  riskLevel       Int       @default(0)
  violationCount  Int       @default(0)  // 累计违规次数
  riskUpdatedAt   DateTime?
  riskNote        String?  // 风险操作备注（手动调整时记录）
  wechatOpenId    String?  @unique      // 微信公众号 openid
  phone           String?  @unique      // 手机号
  loginMethod     String?               // 登录方式：password / email_code / wechat / phone
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects        Project[]
  works           Work[]
  comments        Comment[]
  likes           Like[]
  generationLogs  GenerationLog[]
  quota           UserQuota?
  tasks           UserTask[]
  payments        PaymentOrder[]
  subscriptions   Subscription[]
  moderationLogs  ModerationLog[]

  @@index([role])
  @@index([enabled, riskLevel])
}

// ==================== 小说项目 ====================
model Project {
  id        String   @id @default(cuid())
  title     String
  genre     String?
  synopsis  String?
  status    String   @default("draft") // draft | ongoing | completed
  cover     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  volumes   Volume[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Volume {
  id        String   @id @default(cuid())
  name      String
  summary   String?
  sort      Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Chapter {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  wordCount  Int      @default(0)
  sort       Int      @default(0)
  volumeId   String
  volume     Volume   @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([volumeId])
}

// ==================== 社区作品 ====================
model Work {
  id          String    @id @default(cuid())
  title       String
  type        String    // novel | image | audio | video | comic
  subtype     String?   // 二级分类：古风玄幻 / 治愈插画 / 情感旁白 / 赛博朋克 / 日漫黑白 等
  content     String    // 正文内容 / 图片URL列表 / 音视频URL
  cover       String?
  tags        String?   // JSON array string
  hidden      Boolean   @default(false)  // 管理下架：true = 用户侧不可见
  likesCount  Int       @default(0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([type])
  // 社区列表高频查询：按 hidden 过滤 + createdAt 排序
  @@index([hidden, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId])
}

model Like {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workId, userId])
  @@index([workId])
}

// ==================== 订阅 ====================
model Subscription {
  id        String   @id @default(cuid())
  planId    String   // free | pro | business | enterprise
  status    String   @default("active") // active | expired | cancelled
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================== AI 供应商 ====================
model AIProvider {
  id          String   @id @default(cuid())
  name        String   @unique  // pollinations, zhipu, dashscope, seedance, kling
  displayName String
  type        String   // llm | image | audio | video | multimodal
  baseUrl     String
  apiKeyEnv   String?  // 环境变量名（不存明文 key）
  status      String   @default("active") // active | disabled
  config      String?  // JSON: 额外配置（超时、重试策略等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models      AIModel[]
}

// ==================== AI 模型 ====================
model AIModel {
  id          String   @id @default(cuid())
  name        String   @unique // sdxl, flux, gpt-4, glm-4 等
  displayName String   // SDXL 基础, Flux Dev
  type        String   // novel | image | comic | audio | video
  providerId  String
  provider    AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tag         String?  // 通用, 高质量, 长文本, 风格
  desc        String?  // 模型描述
  // 积分制度：每次调用消耗多少积分（用户支付价，含毛利）
  // Pollinations 模型由 pollinationsSync 自动按公式计算：
  //   costTokens = ceil(baseTokens × (1 + margin/100))
  //   baseTokens = ceil(pollen × POLLINATIONS_TOKEN_RATIO(10) × durationSec)
  // 非 Pollinations 模型由管理后台手动定价
  costTokens  Int      @default(1000)
  // 毛利率（百分比，0 = 无溢价），默认 0
  // 公式：costTokens = ceil(baseTokens × (1 + margin/100))
  // 示例：baseTokens=10, margin=0 → 10 积分；margin=50 → 15 积分；margin=100 → 20 积分
  // Pollinations 模型由 sync 自动算 costTokens 时用此值；非 Pollinations 模型此字段仅作参考
  margin      Float    @default(0.0)
  status      String   @default("active") // active | disabled
  sort        Int      @default(0)
  config      String?  // JSON: 模型特定参数（max_tokens, default_params 等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId])
  @@index([type])
}

// ==================== 生成记录 ====================
model GenerationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // novel | image | comic | audio | video
  modelId     String?  // 使用的 AI 模型名称
  provider    String?  // 供应商名称
  input       String?  // JSON: 输入参数摘要
  output      String?  // JSON: 输出结果摘要（URL/文本片段）
  // 毛利对账字段（2026-09 升级，支持差值统计）
  // marginAtCall = 调用时的 margin 快照（百分比，如 0/50/100）
  //   costTokens = 用户支付的积分（tokensUsed，含毛利）
  //   baseTokens = tokensUsed / (1 + marginAtCall/100) ≈ 官方成本积分
  //   revenueTokens = 毛利积分 = tokensUsed - baseTokens
  tokensUsed  Int      @default(0)  // 用户支付的积分（售价，含毛利）
  costTokens      Int?  @default(0) // 内部成本积分（≈ tokensUsed/(1+margin/100)）
  marginAtCall    Float? @default(0.0) // 调用时的 margin 快照（百分比）
  revenueTokens   Int?  @default(0) // 毛利积分 = tokensUsed - costTokens
  duration    Int      @default(0)  // 耗时(ms)
  status      String   @default("success") // success | failed | pending
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  // 管理端统计：按类型 + 时间范围聚合
  @@index([type, createdAt])
  // 毛利统计：按模型 + 时间范围聚合
  @@index([modelId, createdAt])
  // 毛利统计：按状态筛选 success
  @@index([status, createdAt])
}

// ==================== 内容审核记录（双审核） ====================
// 追加不可改：仅 create + read，无 update/delete 路由（防抵赖）
// 后台"已处理"标记独立到 ModerationLogHandle 子表，主表保持纯 append
model ModerationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage       String   // input | output  审核阶段（输入审核/输出审核）
  endpoint    String   // 触发的接口路径（如 /api/llm/continue-text）
  content     String   // 被审核的文本片段（截断 500 字，避免存储膨胀）
  result      String   // pass | block | warning
  riskLevel   String   // low | medium | high
  reason      String?  // 违规原因 / 命中的分类说明
  categories  String?  // JSON: 命中的违规分类列表
  provider    String   // local | aliyun | zhipu  审核服务商
  placeholder Boolean  @default(false)  // true = demo 模式占位审核（无 API key）
  createdAt   DateTime @default(now())

  // 反向关系：处置记录（一条审核日志可有多条处置记录，append-only 留痕）
  handles     ModerationLogHandle[]

  @@index([userId])
  @@index([result])
  @@index([riskLevel])
  @@index([createdAt])
}

// ==================== 审核日志处置记录（append-only） ====================
// 与 ModerationLog 解耦，主表 append-only 不可改，处置标记独立到这里
// 一条审核日志可有多条处置记录，支持多次处置留痕（防抵赖）
model ModerationLogHandle {
  id          String   @id @default(cuid())
  logId       String
  log         ModerationLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  // 处置类型：marked_viewed | marked_handled | dismissed | escalated
  action      String
  // 处置人（管理员 ID）
  handlerId   String
  // 处置备注（rejected/banned 时必填，参考后台管理规范 13.2）
  note        String?
  createdAt   DateTime @default(now())

  @@index([logId])
  @@index([handlerId])
  @@index([createdAt])
}

// ==================== 用户额度 ====================
model UserQuota {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTokens     Int      @default(0)       // 总额度（需充值获取，新用户不赠送）
  usedTokens      Int      @default(0)       // 已用额度
  remainingTokens Int     @default(0)        // 剩余额度 = total - used
  planId          String   @default("free")   // free | pro | business | enterprise
  resetAt         DateTime?                   // 额度重置时间
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    TokenTransaction[]
}

// ==================== 积分流水（不可篡改，所有积分变动都要记） ====================
// 每一笔积分变动都有流水记录，支持：
//   - 预扣（pending）→ 结算（settled）/ 退还（refunded）
//   - 充值（recharge）
//   - 管理员调整（admin_adjust）
//   - 系统补偿（compensation）
model TokenTransaction {
  id            String   @id @default(cuid())
  userId        String
  quota         UserQuota @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // 变动类型
  type          String   // deduct | refund | recharge | admin_adjust | compensation | system_refund
  // 状态
  status        String   // pending | settled | refunded | failed | completed
  // 积分变动量（正数=增加，负数=扣减）
  amount        Int
  // 变动前余额
  balanceBefore Int
  // 变动后余额
  balanceAfter  Int

  // 关联信息
  relatedType   String?  // generation | task | order | admin | system
  relatedId     String?  // 关联的生成日志ID / 任务ID / 订单ID / 管理员ID
  modelId       String?  // 关联的AI模型
  provider      String?  // 供应商

  // 备注
  reason        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([relatedType, relatedId])
  @@index([createdAt])
}

// ==================== 异步任务 ====================
model UserTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // text2video | img2video | tts | music | lora_train
  status      String   @default("pending") // pending | processing | completed | failed
  params      String?  // JSON: 任务参数
  result      String?  // JSON: 任务结果
  progress    Int      @default(0)  // 0-100
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  // 用户任务列表：按用户 + 状态查询
  @@index([userId, status])
}

// ==================== 充值订单 ====================
model PaymentOrder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // 充值金额（分）
  tokens      Int      // 购买的 token 数
  planId      String?  // 关联的订阅计划
  status      String   @default("pending") // pending | paid | failed | refunded
  payMethod   String?  // alipay | wechat | card
  tradeNo     String?  // 第三方交易号
  createdAt DateTime @default(now())
  paidAt      DateTime?
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ==================== 板块功能配置 ====================
model ModuleFeature {
  id          String   @id @default(cuid())
  module      String   // novel | image | comic | audio | video | community
  featureKey  String   // prompt_input, model_selector, negative_prompt...
  displayName String   // 正向提示词, 负向提示词, 模型选择...
  type        String   // text | textarea | slider | select | toggle | upload | color | custom | number
  status      String   @default("enabled") // enabled | disabled
  sort        Int      @default(0)  // 排序（控制前端布局顺序）
  config      String?  // JSON: { min, max, step, defaultValue, options, label, placeholder }
  value       String?  // 当前值（JSON序列化，与 type 对应）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, featureKey])
  @@index([module])
}

// ==================== 全局站点配置（可视化调整入口） ====================
model SiteConfig {
  id          String   @id @default(cuid())
  group       String   // brand | hero | landing-novel | landing-canvas | landing-audio | landing-community | pricing | rate-limit | safety | announcement | recommend | default-ai-model
  key         String   // 唯一键 e.g. brand.site_name / rate-limit.llm_per_min
  value       String   // 值：JSON string，以适配 text/number/bool/color/json 多种类型
  controlType String   // text | textarea | number | slider | color | switch | select
  label       String   // 控件标题「站点名称」
  description String?  // 提示说明
  sort        Int      @default(0)
  icon        String?  // lucide icon name
  config      String?  // JSON: {min/max/step/options/rows/regex/defaultValue}
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([group, key])
  @@index([group])
}

// ==================== 站点配置变更审计（回滚保障） ====================
model SiteConfigAuditLog {
  id        String   @id @default(cuid())
  group     String
  key       String
  oldValue  String?
  newValue  String
  operator  String?  // user id
  action    String   // CREATE | UPDATE | ROLLBACK
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([key])
  @@index([createdAt])
  @@index([operator])
}
// ==================== Pollinations 官方定价同步日志 ====================
// 每周自动从 https://gen.pollinations.ai/v1/models 拉取官方定价
// 同步 AIModel 的 costTokens（汇率: 1 pollen = 1000 积分）
model PollinationsSyncLog {
  id             String   @id @default(cuid())
  trigger        String   // cron | manual | catchup
  status         String   // success | failed | partial
  startedAt      DateTime
  endedAt        DateTime?
  pollenFxRate   Float    // 汇率：1 pollen = ? 积分（默认 1000）
  modelsChecked  Int      // 检查的模型总数
  modelsUpdated  Int      // 实际更新的模型数
  modelsAdded    Int      // 新增的模型数
  modelsRemoved  Int      // 下架的模型数
  diffJson       String?  // JSON: [{modelId, oldCost, newCost, change}]
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([trigger])
}