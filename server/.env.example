# =====================================================
# Man TV · 后端服务环境变量模板 (.env.example)
# =====================================================
# 🔒 使用方法：复制本文件为 .env，然后填写真实值
#    cp .env.example .env
# ⚠️ 警告：.env 已被 .gitignore 排除，严禁提交到代码仓库
# 📌 本模板与代码 1:1 对齐：仅列出 src/ 中实际 process.env.* 读取的变量
# =====================================================

# ---------- 服务基础配置 ----------
# 后端监听端口（默认 3000）
PORT=3000

# 前端地址（CORS 白名单，Vite 默认端口 5176）
# 支持多个域名（逗号分隔），生产环境请使用 HTTPS
# 示例：FRONTEND_URL=https://www.manktv.com,https://manktv.com
FRONTEND_URL=http://localhost:5176

# 是否允许子域名跨域（默认 false，需显式设为 true 才启用）
# 启用后所有 *.FRONTEND_URL 的子域均可跨域，若子域被攻击者控制可发起带凭证请求
# CORS_ALLOW_SUBDOMAINS=false

# 部署在反向代理（Nginx）后时设为 true
# 启用后会信任 X-Forwarded-For 头，IP 限流才能正常工作
# ⚠️ 裸部署（直接暴露 3000 端口）时请勿开启，防止 IP 伪造绕流
# BEHIND_PROXY=false

# ---------- 运行时与日志 ----------
# 日志级别：debug / info / warn / error（默认 info）
# LOG_LEVEL=info

# 异步任务并发数（视频/图像生成 worker 并发，默认 3）
# WORKER_CONCURRENCY=3

# 对外可访问的基础 URL（拼接上传媒体外链用，默认取请求 Origin）
# 生产经 nginx 同源反代时通常无需配置；仅当后端直连地址不对外时可显式指定
# PUBLIC_BASE_URL=https://gaike.xyz

# ---------- JWT 认证密钥（强制校验，至少 16 字符） ----------
# 🚨 生产环境务必使用随机字符串，例如：
#   openssl rand -hex 32
# 或：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d

# ---------- 图片代理签名密钥（强制校验，至少 16 字符） ----------
# 用于签名图片代理 URL，防止 SSRF 攻击。请使用独立于 JWT_SECRET 的随机值
# 生成方式同上
IMAGE_SIGNING_SECRET=please-change-this-to-another-long-random-string

# ---------- 数据库（PostgreSQL 生产推荐，SQLite 开发可选） ----------
# PostgreSQL 生产环境（推荐）
DATABASE_URL="postgresql://user:password@localhost:5432/manktv?schema=public"
#
# SQLite 开发环境（轻量、零配置，适合本地快速启动）
# DATABASE_URL="file:./dev.db"
#
# 切换数据库步骤：
#   1. 修改 DATABASE_URL 为目标数据库
#   2. 修改 prisma/schema.prisma 的 provider（postgresql / sqlite）
#   3. 运行 npm run prisma:generate
#   4. PostgreSQL 迁移：npm run prisma:deploy

# ---------- AI 供应商 · Pollinations（统一 API） ----------
# 文档：https://gen.pollinations.ai/docs
# 申请 Key：https://enter.pollinations.ai/keys
#
# Key 类型：
#   sk_ — 密钥，服务端使用，无限流，需账户余额
#   pk_ — 公钥，前端使用，1 pollen/IP/小时限流（遗留模式）
#
# 不配置 Key 时所有 AI 接口返回占位数据（演示模式）
POLLINATIONS_API_KEY=sk-your-pollinations-key-here
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# ---------- 积分换算（运营总览显示用，不影响实际扣费） ----------
# 官方定价：$1 ≈ 1 pollen。仅修改展示的等值美元/人民币，不影响积分扣减
# POLLEN_PER_USD=1
# USD_TO_CNY_RATE=7.2  # 强制覆盖动态汇率（默认从公开 API 获取）
#
# 1 pollen 兑换多少平台积分（影响 costTokens 换算，默认 10）
# POLLINATIONS_TOKEN_RATIO=10

# ---------- LLM 文本供应商（剧本/提示词生成，默认智谱） ----------
# 提供商：zhipu（默认）/ pollinations
# LLM_PROVIDER=zhipu
#
# 智谱 GLM-4-Flash 永久免费、无 Token 上限；申请：https://open.bigmodel.cn/
# 未配置 Key 时自动降级为模板兜底（不报错）
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_LLM_MODEL=glm-4.7-flash
#
# Pollinations LLM（LLM_PROVIDER=pollinations 时使用）
POLLINATIONS_LLM_MODEL=openai

# ---------- 视频/图像供应商 · 阿里云百炼 DashScope（可选） ----------
# 通义万相（图像）与可灵（视频）均走百炼 DashScope 端点
# 申请：https://bailian.console.aliyun.com/ → API-KEY 管理
# 不配置时视频/图像生成走 Pollinations
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# （等价别名，二选一即可）
# ALIYUN_DASHSCOPE_API_KEY=sk-your-dashscope-key
#
# 百炼业务空间 ID（子工作空间调用时必填，主账号可留空）
# ALIBABA_CLOUD_WORKSPACE_ID=
# （备用 Key 名，与 DASHSCOPE_API_KEY 二选一）
# ALIBABA_CLOUD_API_KEY=sk-your-dashscope-key
#
# 默认视频模型（视频生成与计费估算统一引用，默认 seedance-pro）
# DEFAULT_VIDEO_MODEL=seedance-pro

# ---------- 漫画生成 ----------
# 图像直出端点（默认 Pollinations 图像接口）
# IMAGE_PROVIDER_URL=https://gen.pollinations.ai/image
# 漫画模型名（计费用，默认 comic-pro）
# COMIC_MODEL=comic-pro

# ---------- 文件上传 ----------
# 相对于 server 目录的上传路径
UPLOAD_DIR=./uploads

# ---------- 内容安全审核（合规必备：双审核 + 至少两家服务商） ----------
# 审核开关与严格度：在后台「站点配置」中动态设置（不读环境变量）
# 服务商选择：aliyun（阿里云内容安全） 或 zhipu（智谱内容安全）
# 不配置 MODERATION_API_KEY 时为 Demo 模式（仅本地敏感词兜底，标记 placeholder）
MODERATION_PROVIDER=aliyun
#
# 阿里云内容安全 Green（需要同时配置 Key 和 Secret）
#   开通地址：https://www.aliyun.com/product/lvwang
#   文档：https://help.aliyun.com/document_detail/70439.html
MODERATION_API_KEY=your-aliyun-access-key-id
MODERATION_API_SECRET=your-aliyun-access-key-secret
MODERATION_REGION=cn-shanghai
#
# 智谱内容安全（只需 API Key）
#   开通地址：https://open.bigmodel.cn/
#   文档：https://open.bigmodel.cn/dev/api#moderation
# MODERATION_API_KEY=your-zhipu-api-key
# MODERATION_PROVIDER=zhipu

# ---------- 节点环境 ----------
# NODE_ENV=production

# ---------- Redis（异步任务队列，生产推荐） ----------
# 不配置时自动降级为内存队列（开发模式可用，多实例部署必须配置）
#
# 方式一：连接串（推荐）
# REDIS_URL=redis://:password@localhost:6379/0
#
# 方式二：单独配置
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------- 短信验证码（阿里云 SMS，可选） ----------
# 手机号验证码登录；未配置时为开发模式：验证码打印到服务端控制台
# 申请：阿里云控制台 → 短信服务（需签名 + 模板审核通过）
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 微信公众号扫码登录（可选） ----------
# 不配置时为开发模式：生成模拟二维码，6 秒后自动"扫码登录"（方便前端调试）
#
# 正式接入需要：
#   1. 微信公众号（服务号，需企业主体 + 300元/年认证费）
#   2. 网站 ICP 备案
#   3. 在公众号后台配置服务器地址（回调 URL）
#
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_APP_SECRET=your_wechat_app_secret

# ====== Mureka AI Music API ======
# 从 https://platform.mureka.cn 获取 API Key
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.cn
